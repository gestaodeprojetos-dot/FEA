{
  // Publicação da página MPL em código no MESMO endereço: pl.joaopithon.com.br/mpl
  "name": "fea-mpl-masterclass-labial",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "pl.joaopithon.com.br/mpl", "zone_name": "joaopithon.com.br" },
    { "pattern": "pl.joaopithon.com.br/mpl/*", "zone_name": "joaopithon.com.br" }
  ],
  "workers_dev": false
}
