# Copiar para .env (nunca versionar o .env) e preencher.
# Server URL da instância: painel uazapi > instância > endereço do servidor
FEA_UAZAPI_URL=https://SEU-SUBDOMINIO.uazapi.com
# Token da instância (header "token")
FEA_UAZAPI_TOKEN=
# Opcional: admintoken, só para listar/criar instâncias
FEA_UAZAPI_ADMIN=
